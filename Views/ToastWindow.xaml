<Window x:Class="GameModeHub.Views.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False" Opacity="0"
        FontFamily="{StaticResource UiFont}" Foreground="{DynamicResource TextBrush}" Topmost="True" ShowActivated="False" Focusable="False"
        SizeToContent="WidthAndHeight" ResizeMode="NoResize">
    <Border x:Name="Caixa" Background="{DynamicResource ToastBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
            CornerRadius="16" MinWidth="300" MaxWidth="560" Margin="18" RenderTransformOrigin="0.5,1">
        <Border.RenderTransform><TranslateTransform x:Name="Deslize" Y="12"/></Border.RenderTransform>
        <Border.Effect><DropShadowEffect BlurRadius="30" ShadowDepth="6" Opacity="0.45"/></Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Width="38" Height="38" CornerRadius="11" Background="{DynamicResource AccentSoftBrush}" Margin="14,12,0,12" VerticalAlignment="Center">
                <TextBlock x:Name="Icone" Text="🎮" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Grid.Column="1" Margin="12,12,22,12" VerticalAlignment="Center">
                <TextBlock x:Name="Titulo" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="Detalhe" FontSize="12.5" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
